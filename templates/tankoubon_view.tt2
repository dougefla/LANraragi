<!DOCTYPE html>

<head>
    <title>[% title %] - [% tank.name %]</title>

    <meta name="viewport" content="width=device-width" />
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />

    <link type="image/png" rel="icon" href="favicon.ico" />
    <link rel="stylesheet" type="text/css" href="[% c.url_for('/css/lrr.css?version=' _ version) %]" />
    <link rel="stylesheet" type="text/css" href="[% c.url_for('/css/vendor/fontawesome-all.min.css') %]" />
    <link rel="stylesheet" type="text/css" href="[% c.url_for('/css/vendor/ReactToastify.min.css') %]" />
    <link rel="stylesheet" type="text/css" href="[% c.url_for('/css/vendor/sweetalert2.min.css') %]" />

    <style>
        .tankoubon-header {
            display: flex;
            gap: 20px;
            margin-bottom: 30px;
            padding: 20px;
            background: #2a2a2a;
            border-radius: 10px;
        }

        .tankoubon-cover {
            flex: 0 0 300px;
            text-align: center;
        }

        .tankoubon-cover img {
            max-width: 100%;
            max-height: 400px;
            border-radius: 5px;
            box-shadow: 0 4px 8px rgba(0,0,0,0.2);
        }

        .tankoubon-info {
            flex: 1;
            padding: 10px;
        }

        .tankoubon-title {
            font-size: 24px;
            font-weight: bold;
            margin-bottom: 15px;
        }

        .tankoubon-stats {
            display: flex;
            gap: 20px;
            margin-bottom: 15px;
            color: #888;
        }

        .stat-item {
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .archive-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 20px;
            padding: 20px;
        }

        .archive-card {
            background: #2a2a2a;
            border-radius: 8px;
            overflow: hidden;
            transition: transform 0.2s;
            position: relative;
        }

        .archive-card:hover {
            transform: translateY(-5px);
        }

        .archive-cover {
            position: relative;
            padding-top: 141%; /* Maintain aspect ratio */
            overflow: hidden;
        }

        .archive-cover img {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .archive-info {
            padding: 15px;
        }

        .archive-title {
            font-weight: bold;
            margin-bottom: 10px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .archive-progress {
            height: 4px;
            background: #444;
            border-radius: 2px;
            overflow: hidden;
        }

        .progress-bar {
            height: 100%;
            background: #4CAF50;
            width: 0%;
        }

        .read-status {
            position: absolute;
            top: 10px;
            right: 10px;
            background: rgba(0,0,0,0.7);
            color: white;
            padding: 4px 8px;
            border-radius: 4px;
            font-size: 12px;
        }

        .order-number {
            position: absolute;
            top: 10px;
            left: 10px;
            background: rgba(0,0,0,0.7);
            color: white;
            padding: 4px 8px;
            border-radius: 4px;
            font-size: 12px;
        }

        .action-buttons {
            margin-top: 20px;
        }

        .action-buttons .stdbtn {
            margin-right: 10px;
        }

        .reading-mode {
            margin-bottom: 20px;
            padding: 15px;
            background: #2a2a2a;
            border-radius: 8px;
        }

        .reading-mode select {
            margin-left: 10px;
            padding: 5px;
            border-radius: 4px;
        }

        /* Navigation buttons */
        .nav-buttons {
            position: fixed;
            bottom: 20px;
            right: 20px;
            display: flex;
            gap: 10px;
        }

        .nav-btn {
            background: #4CAF50;
            color: white;
            border: none;
            border-radius: 50%;
            width: 50px;
            height: 50px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            box-shadow: 0 2px 5px rgba(0,0,0,0.2);
            transition: background 0.2s;
        }

        .nav-btn:hover {
            background: #45a049;
        }

        .nav-btn:disabled {
            background: #666;
            cursor: not-allowed;
        }
    </style>

    [% csshead %]

    <script src="[% c.url_for('/js/vendor/jquery.min.js') %]" type="text/JAVASCRIPT"></script>
    <script src="[% c.url_for('/js/vendor/preact.umd.js') %]" type="text/JAVASCRIPT"></script>
    <script src="[% c.url_for('/js/vendor/hooks.umd.js') %]" type="text/JAVASCRIPT"></script>
    <script src="[% c.url_for('/js/vendor/compat.umd.js') %]" type="text/JAVASCRIPT"></script>
    <script>window.React = window.preactCompat; window.react = window.preactCompat;</script>
    <script src="[% c.url_for('/js/vendor/clsx.min.js') %]" type="text/JAVASCRIPT"></script>
    <script src="[% c.url_for('/js/vendor/react-toastify.umd.js') %]" type="text/JAVASCRIPT"></script>
    <script src="[% c.url_for('/js/vendor/sweetalert2.min.js') %]" type="text/JAVASCRIPT"></script>
    
    <script src="[% c.url_for('/js/i18n.js?version=' _ version) %]" type="text/JAVASCRIPT"></script>
    <script src="[% c.url_for('/js/common.js?version=' _ version) %]" type="text/JAVASCRIPT"></script>
    <script src="[% c.url_for('/js/server.js?version=' _ version) %]" type="text/JAVASCRIPT"></script>
    <script src="[% c.url_for('/js/tankoubon_view.js?version=' _ version) %]" type="text/JAVASCRIPT"></script>
</head>

<body>

    [% INCLUDE header %]

    <div class='ido' style='text-align:center'>
        <div class="tankoubon-header">
            <div class="tankoubon-cover">
                <img src="[% cover_url %]" alt="Cover">
            </div>
            <div class="tankoubon-info">
                <div class="tankoubon-title">[% tank.name %]</div>
                <div class="tankoubon-stats">
                    <div class="stat-item">
                        <i class="fas fa-book"></i>
                        <span>[% tank.archives.size %] Archives</span>
                    </div>
                    <div class="stat-item">
                        <i class="fas fa-clock"></i>
                        <span>Last Modified: [% tank.last_modified | format_date %]</span>
                    </div>
                    <div class="stat-item">
                        <i class="fas fa-tasks"></i>
                        <span id="reading-progress">Reading Progress: 0%</span>
                    </div>
                </div>
                <div class="action-buttons">
                    <button class="stdbtn" onclick="TankoubonView.startReading()">
                        <i class="fas fa-book-reader"></i> Start Reading
                    </button>
                    <button class="stdbtn" onclick="TankoubonView.continueReading()">
                        <i class="fas fa-bookmark"></i> Continue
                    </button>
                    <button class="stdbtn" onclick="TankoubonView.markAsRead()">
                        <i class="fas fa-check"></i> Mark All as Read
                    </button>
                    <button class="stdbtn" onclick="TankoubonView.showEditDialog()">
                        <i class="fas fa-edit"></i> Edit
                    </button>
                </div>
            </div>
        </div>

        <div class="reading-mode">
            <label>Reading Mode:</label>
            <select id="reading-mode" onchange="TankoubonView.changeReadingMode()">
                <option value="grid">Grid View</option>
                <option value="list">List View</option>
                <option value="continuous">Continuous View</option>
            </select>
        </div>

        <div id="archive-container" class="archive-grid">
            <!-- Archives will be loaded here -->
        </div>

        <div class="nav-buttons">
            <button class="nav-btn" id="prev-archive" onclick="TankoubonView.navigateArchive('prev')" title="Previous Archive">
                <i class="fas fa-chevron-left"></i>
            </button>
            <button class="nav-btn" id="next-archive" onclick="TankoubonView.navigateArchive('next')" title="Next Archive">
                <i class="fas fa-chevron-right"></i>
            </button>
        </div>
    </div>

    [% INCLUDE footer %]
</body>

</html> 