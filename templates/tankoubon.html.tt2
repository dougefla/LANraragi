<!DOCTYPE html>

<head>
    <title>[% title %] - Tankoubon</title>

    <meta name="viewport" content="width=device-width" />
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />

    <link type="image/png" rel="icon" href="favicon.ico" />
    <link rel="stylesheet" type="text/css" href="./css/lrr.css?[% version %]" />
    <link rel="stylesheet" type="text/css" href="./css/vendor/fontawesome/all.min.css" />
    <link rel="stylesheet" type="text/css" href="./css/vendor/jquery.contextMenu.min.css" />
    <link rel="stylesheet" type="text/css" href="./css/vendor/allcollapsible.min.css" />
    <link rel="stylesheet" type="text/css" href="./css/vendor/swiper.min.css" />
    <link rel="stylesheet" type="text/css" href="[% c.url_for('/css/vendor/ReactToastify.min.css') %]" />
    <link rel="stylesheet" type="text/css" href="[% c.url_for('/css/vendor/sweetalert2.min.css') %]" />

    <style>
        .grid-view {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(228px, 1fr));
            gap: 5px;
            padding: 5px;
        }

        .tankoubon-card {
            background: none repeat scroll 0 0 #43464E;
            border: 1px none;
            border-radius: 9px;
            display: inline-block;
            margin: 3px 2px 2px 3px;
            padding-top: 3px;
            vertical-align: top;
            min-height: 335px;
            cursor: pointer;
        }

        .tankoubon-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }

        .tankoubon-card .preview {
            height: 280px;
            margin: auto;
            overflow: hidden;
            position: relative;
            text-align: center;
        }

        .tankoubon-card .preview img {
            max-width: 95%;
            max-height: 275px;
            object-fit: contain;
            border-radius: 7px;
        }

        .tankoubon-card .info {
            padding: 5px;
        }

        .tankoubon-card .name {
            font-weight: bold;
            min-height: 32px;
            margin: auto;
            text-align: center;
            width: 97%;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .tankoubon-card .stats {
            height: 20px;
            margin: auto;
            position: relative;
            text-align: center;
            padding: 0 4px;
            color: #666;
            font-size: 0.9em;
            display: flex;
            justify-content: space-between;
        }

        /* No Results Message */
        .no-results {
            text-align: center;
            padding: 40px;
            color: #666;
        }

        #toolbar {
            display: flex;
            align-items: center;
            padding: 10px 0;
            margin-bottom: 20px;
        }

        .search-container {
            flex: 1;
            margin-right: 10px;
        }

        .search-input {
            width: 100%;
            padding: 8px;
            border-radius: 4px;
            border: 1px solid #ddd;
        }
    </style>

    [% csshead %]

    <script src="./js/vendor/jquery.min.js" type="text/JAVASCRIPT"></script>
    <script src="./js/vendor/jquery.dataTables.min.js" type="text/JAVASCRIPT"></script>
    <script src="./js/vendor/jquery.contextMenu.min.js" type="text/JAVASCRIPT"></script>
    <script src="./js/vendor/jquery.ui.position.min.js" type="text/JAVASCRIPT"></script>
    <script src="./js/vendor/allcollapsible.min.js" type="text/JAVASCRIPT"></script>
    <script src="./js/vendor/swiper.min.js" type="text/JAVASCRIPT"></script>
    <script src="./js/vendor/sweetalert2.min.js" type="text/JAVASCRIPT"></script>

    <script src="./js/i18n.js?[% version %]" type="text/JAVASCRIPT"></script>
    <script src="./js/common.js?[% version %]" type="text/JAVASCRIPT"></script>
    <script src="./js/server.js?[% version %]" type="text/JAVASCRIPT"></script>
    <script src="./js/tankoubon.js?[% version %]" type="text/JAVASCRIPT"></script>
</head>

<body>

    [% IF userlogged %]
    <p id="nb">
        <i class="fa fa-caret-right"></i>
        <a href="[% c.url_for("/upload") %]">[% c.lh("Add Archives") %]</a>
        <span style="margin-left:5px"></span>
        <i class="fa fa-caret-right"></i>
        <a href="[% c.url_for("/batch") %]">[% c.lh("Batch Operations") %]</a>
        <span style="margin-left:5px"></span>
        <i class="fa fa-caret-right"></i>
        <a href="[% c.url_for("/config") %]">[% c.lh("Settings") %]</a>
        <span style="margin-left:5px"></span>
        <i class="fa fa-caret-right"></i>
        <a href="[% c.url_for("/config/categories") %]">[% c.lh("Modify Categories") %]</a>
        <span style="margin-left:5px"></span>
        <i class="fa fa-caret-right"></i>
        <a href="[% c.url_for("/category_grid") %]">[% c.lh("Category Grid") %]</a>
        <span style="margin-left:5px"></span>
        <i class="fa fa-caret-right"></i>
        <a href="[% c.url_for("/tankoubon") %]">[% c.lh("Tankoubon") %]</a>
        <span style="margin-left:5px"></span>
        <i class="fa fa-caret-right"></i>
        <a href="[% c.url_for("/tankoubons") %]">[% c.lh("Tankoubon Management") %]</a>
        <span style="margin-left:5px"></span>
        <i class="fa fa-caret-right"></i>
        <a href="[% c.url_for("/stats") %]">[% c.lh("Statistics") %]</a>
        <i class="fa fa-caret-right"></i>
        <a href="[% c.url_for("/logs") %]">[% c.lh("Logs") %]</a>
    </p>
    [% ELSE %]
    <p id="nb">
        <i class="fa fa-caret-right"></i>
        <a href="[% c.url_for("/login") %]">[% c.lh("Admin Login") %]</a>
        <span style="margin-left:5px"></span>
        <i class="fa fa-caret-right"></i>
        <a href="[% c.url_for("/stats") %]">[% c.lh("Statistics") %]</a>
    </p>
    [% END %]

    <div class='ido'>
        <h2 class='ih' style='text-align:center'>
            [% c.lh("Tankoubon Management") %]
        </h2>

        <!-- Carousel -->
        <div class="option-flyout index-carousel">
            <div class="collapsible-title">
                <i class="fas fa-book-open"></i>
                <span id="carousel-title">[% c.lh("On Deck") %]</span>
                <a href="#" id="carousel-mode-menu" class="table-option" title="[% c.lh('Change carousel mode') %]">
                    <i class="fas fa-cog"></i>
                </a>
                <a href="#" id="reload-carousel" class="table-option" title="[% c.lh('Reload carousel') %]">
                    <i class="fas fa-sync-alt"></i>
                </a>
            </div>
            <div class="collapsible-body">
                <div class="index-carousel-container">
                    <div class="swiper">
                        <div class="swiper-wrapper"></div>
                    </div>
                    <div class="carousel-prev">
                        <i class="fas fa-chevron-left fa-3x"></i>
                    </div>
                    <div class="carousel-next">
                        <i class="fas fa-chevron-right fa-3x"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Search/Filter Options -->
        <div class="table-options">
            <input type="text" id="search-input" class="search-input" placeholder="[% c.lh('Search title, tags...') %]">

            <select id="namespace-sortby" class="favtag-btn" style="width:200px">
                <option value="">[% c.lh("Sort by...") %]</option>
                <option value="name">[% c.lh("Name") %]</option>
                <option value="date_added">[% c.lh("Date Added") %]</option>
                <option value="last_updated">[% c.lh("Last Updated") %]</option>
            </select>

            <a href="#" class="mode-toggle stdbtn" title="[% c.lh('Switch Display Mode') %]">
                <i class="fas fa-th-large"></i>
            </a>

            <input type="checkbox" id="thumbnail-crop" class="fa" title="[% c.lh('Crop thumbnails') %]" />
        </div>

        <!-- Main Content Area -->
        <div id="tankoubon-container">
            <!-- Grid View -->
            <div id="tankoubon-grid" class="thumbnail-view"></div>

            <!-- List View -->
            <table id="tankoubon-list" class="list-view" style="display:none">
                <thead>
                    <tr>
                        <th>[% c.lh("Title") %]</th>
                        <th>[% c.lh("Archives") %]</th>
                        <th>[% c.lh("Date Added") %]</th>
                        <th>[% c.lh("Last Updated") %]</th>
                        <th>[% c.lh("Actions") %]</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>

    <div id="overlay-shade"></div>

    [% INCLUDE footer %]
</body>

</html> 