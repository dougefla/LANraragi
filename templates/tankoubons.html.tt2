<!DOCTYPE html>

<head>
    <title>[% title %] - [% c.lh("Tankoubons") %]</title>

    <meta name="viewport" content="width=device-width" />
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />

    <link type="image/png" rel="icon" href="[% c.url_for('/favicon.ico') %]" />
    <link rel="stylesheet" type="text/css" href="[% c.url_for('/css/lrr.css?version=' _ version) %]" />
    <link rel="stylesheet" type="text/css" href="[% c.url_for('/css/vendor/fontawesome-all.min.css') %]" />
    <link rel="stylesheet" type="text/css" href="[% c.url_for('/css/vendor/jquery.contextMenu.min.css') %]" />
    <link rel="stylesheet" type="text/css" href="[% c.url_for('/css/vendor/ReactToastify.min.css') %]" />
    <link rel="stylesheet" type="text/css" href="[% c.url_for('/css/vendor/sweetalert2.min.css') %]" />
    <link rel="stylesheet" type="text/css" href="[% c.url_for('/css/vendor/awesomplete.css') %]" />

    [% csshead %]

    <script src="[% c.url_for('/js/vendor/jquery.min.js') %]" type="text/JAVASCRIPT"></script>
    <script src="[% c.url_for('/js/vendor/jquery.ui.position.min.js') %]" type="text/JAVASCRIPT"></script>
    <script src="[% c.url_for('/js/vendor/jquery.contextMenu.min.js') %]" type="text/JAVASCRIPT"></script>
    <script src="[% c.url_for('/js/vendor/preact.umd.js') %]" type="text/JAVASCRIPT"></script>
    <script src="[% c.url_for('/js/vendor/hooks.umd.js') %]" type="text/JAVASCRIPT"></script>
    <script src="[% c.url_for('/js/vendor/compat.umd.js') %]" type="text/JAVASCRIPT"></script>
    <script>window.React = window.preactCompat; window.react = window.preactCompat;</script>
    <script src="[% c.url_for('/js/vendor/clsx.min.js') %]" type="text/JAVASCRIPT"></script>
    <script src="[% c.url_for('/js/vendor/react-toastify.umd.js') %]" type="text/JAVASCRIPT"></script>
    <script src="[% c.url_for('/js/vendor/sweetalert2.min.js') %]" type="text/JAVASCRIPT"></script>
    <script src="[% c.url_for('/js/vendor/awesomplete.min.js') %]" type="text/JAVASCRIPT"></script>
    
    <script src="[% c.url_for('/js/i18n.js?version=' _ version) %]" type="text/JAVASCRIPT"></script>
    <script src="[% c.url_for('/js/common.js?version=' _ version) %]" type="text/JAVASCRIPT"></script>
    <script src="[% c.url_for('/js/server.js?version=' _ version) %]" type="text/JAVASCRIPT"></script>
    <script src="[% c.url_for('/js/tankoubon.js?version=' _ version) %]" type="text/JAVASCRIPT"></script>

    <style>
        /* Grid View */
        .grid-view {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(228px, 1fr));
            gap: 5px;
            padding: 5px;
        }

        .tankoubon-card {
            background: none repeat scroll 0 0 #43464E;
            border: 1px none;
            border-radius: 9px;
            display: inline-block;
            margin: 3px 2px 2px 3px;
            padding-top: 3px;
            vertical-align: top;
            min-height: 335px;
            cursor: pointer;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
            position: relative;
        }

        .tankoubon-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }

        .tankoubon-card .preview {
            height: 280px;
            margin: auto;
            overflow: hidden;
            position: relative;
            text-align: center;
        }

        .tankoubon-card .preview img {
            max-width: 95%;
            max-height: 275px;
            object-fit: contain;
            border-radius: 7px;
        }

        .tankoubon-card .info {
            padding: 5px;
        }

        .tankoubon-card .name {
            font-weight: bold;
            min-height: 32px;
            margin: auto;
            text-align: center;
            width: 97%;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .tankoubon-card .stats {
            height: 20px;
            margin: auto;
            position: relative;
            text-align: center;
            padding: 0 4px;
            color: #666;
            font-size: 0.9em;
            display: flex;
            justify-content: space-between;
        }

        /* List View */
        .table-list {
            width: 100%;
            border-collapse: collapse;
        }

        .table-list th {
            font-weight: bold;
            text-align: left;
            padding: 8px 12px;
            background: #363940;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .table-list td {
            text-align: left;
            padding: 8px 12px;
            border-right: 1px solid #40454b;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .table-list tr:nth-child(odd) {
            background: #4F535B;
        }

        .table-list tr:nth-child(even) {
            background: #363940;
        }

        .table-list tr:hover {
            background-color: #4a4e57 !important;
        }

        .archive-count {
            position: absolute;
            top: 10px;
            right: 10px;
            background: rgba(70, 130, 180, 0.9);
            color: white;
            padding: 4px 8px;
            border-radius: 12px;
            font-size: 12px;
            font-weight: bold;
            z-index: 1;
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .archive-count i {
            font-size: 10px;
        }

        /* Table Options */
        .table-options {
            margin-right: 4%;
            margin-left: 4%;
            margin-bottom: 20px;
            margin-top: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 10px;
        }

        .table-options > div {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        /* View Toggle */
        .view-toggle {
            display: flex;
            gap: 5px;
            margin-left: 10px;
        }

        .mode-toggle {
            color: #666;
            text-decoration: none;
            opacity: 0.6;
            padding: 0 5px;
        }

        .mode-toggle.active {
            opacity: 1;
            color: #4f535b;
        }

        .mode-toggle:hover {
            opacity: 0.8;
        }

        /* Search Bar */
        .search-container {
            margin: 20px 4%;
            display: flex;
            gap: 10px;
            align-items: center;
        }

        .search-input {
            flex: 1;
            padding: 8px;
            border: 1px solid #4f535b;
            border-radius: 4px;
            background: #363940;
            color: white;
        }

        .search-btn {
            padding: 8px 16px;
            border-radius: 4px;
            background: #4f535b;
            color: white;
            border: none;
            cursor: pointer;
        }

        .search-btn:hover {
            background: #5a5f68;
        }

        /* Loading and Empty States */
        #loading-indicator, #empty-state {
            height: 344px;
            display: flex;
            justify-content: center;
            align-items: center;
            flex-direction: column;
            color: #666;
            margin-top: 20px;
        }

        #empty-state i {
            margin-bottom: 20px;
            color: #999;
        }

        #empty-state span {
            font-size: 1.2em;
        }
    </style>
</head>

<body>
    [% IF userlogged %]
    <p id="nb">
        <i class="fa fa-caret-right"></i>
        <a href="[% c.url_for("/upload") %]">[% c.lh("Add Archives") %]</a>
        <span style="margin-left:5px"></span>
        <i class="fa fa-caret-right"></i>
        <a href="[% c.url_for("/batch") %]">[% c.lh("Batch Operations") %]</a>
        <span style="margin-left:5px"></span>
        <i class="fa fa-caret-right"></i>
        <a href="[% c.url_for("/config") %]">[% c.lh("Settings") %]</a>
        <span style="margin-left:5px"></span>
        <i class="fa fa-caret-right"></i>
        <a href="[% c.url_for("/config/categories") %]">[% c.lh("Modify Categories") %]</a>
        <span style="margin-left:5px"></span>
        <i class="fa fa-caret-right"></i>
        <a href="[% c.url_for("/category_grid") %]">[% c.lh("Category Grid") %]</a>
        <span style="margin-left:5px"></span>
        <i class="fa fa-caret-right"></i>
        <a href="[% c.url_for("/tankoubons") %]">[% c.lh("Tankoubon") %]</a>
        <span style="margin-left:5px"></span>
        <i class="fa fa-caret-right"></i>
        <a href="[% c.url_for("/stats") %]">[% c.lh("Statistics") %]</a>
        <i class="fa fa-caret-right"></i>
        <a href="[% c.url_for("/logs") %]">[% c.lh("Logs") %]</a>
    </p>
    [% ELSE %]
    <p id="nb">
        <i class="fa fa-caret-right"></i>
        <a href="[% c.url_for("/login") %]">[% c.lh("Admin Login") %]</a>
        <span style="margin-left:5px"></span>
        <i class="fa fa-caret-right"></i>
        <a href="[% c.url_for("/stats") %]">[% c.lh("Statistics") %]</a>
    </p>
    [% END %]

    <div class="ido">
        <h1 class="ih">[% c.lh("Tankoubon Management") %]</h1>

        <div class="search-container">
            <input type="text" id="search-input" class="search-input" placeholder="[% c.lh('Search Tankoubons...') %]" />
            <button id="search-btn" class="search-btn">[% c.lh("Search") %]</button>
            <button id="clear-search" class="search-btn">[% c.lh("Clear") %]</button>
        </div>

        <div class="table-options">
            <div>
                <button id="new-tankoubon" class="stdbtn">
                    <i class="fas fa-plus"></i> [% c.lh("New Tankoubon") %]
                </button>
                <button id="refresh" class="stdbtn">
                    <i class="fas fa-sync"></i> [% c.lh("Refresh") %]
                </button>
                <button id="return" class="stdbtn">
                    <i class="fas fa-arrow-left"></i> [% c.lh("Return") %]
                </button>
            </div>

            <div>
                [% c.lh("Sort by:") %]
                <select class="favtag-btn" id="sort-by">
                    <option value="name">[% c.lh("Name") %]</option>
                    <option value="date">[% c.lh("Date Modified") %]</option>
                    <option value="archives">[% c.lh("Archive Count") %]</option>
                </select>
                <a class="fa fa-sort-alpha-down fa-2x table-option" id="sort-order" href="#" 
                   title="[% c.lh('Sort Order') %]"></a>
            </div>

            <div>
                [% c.lh("Items per page:") %]
                <select class="favtag-btn" id="page-size">
                    <option value="25">25</option>
                    <option value="50">50</option>
                    <option value="100" selected>100</option>
                    <option value="200">200</option>
                </select>

                [% c.lh("Page:") %]
                <select class="favtag-btn" id="page-select"></select>

                <div class="view-toggle">
                    <a class="fa fa-list fa-2x mode-toggle" id="list-view" href="#" 
                       title="[% c.lh('List View') %]"></a>
                    <a class="fa fa-th fa-2x mode-toggle" id="grid-view" href="#" 
                       title="[% c.lh('Grid View') %]"></a>
                </div>
            </div>
        </div>

        <div id="tankoubon-list"></div>

        <div id="loading-indicator" style="display: none;">
            <i class="fa fa-4x fa-spinner fa-spin"></i>
        </div>

        <div id="empty-state" style="display: none;">
            <i class="fa fa-4x fa-book-open"></i>
            <span>[% c.lh("No tankoubons found.") %]</span>
        </div>
    </div>

    [% INCLUDE footer %]

    <script>
        jQuery(() => {
            Tankoubon.initializeAll();
        });
    </script>
</body>

</html> 