<!DOCTYPE html>

<head>
    <title>[% title %] - [% c.lh("Tankoubons") %]</title>

    <meta name="viewport" content="width=device-width" />
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />

    <link type="image/png" rel="icon" href="[% c.url_for('/favicon.ico') %]" />
    <link rel="stylesheet" type="text/css" href="[% c.url_for('/css/lrr.css?version=' _ version) %]" />
    <link rel="stylesheet" type="text/css" href="[% c.url_for('/css/vendor/fontawesome-all.min.css') %]" />
    <link rel="stylesheet" type="text/css" href="[% c.url_for('/css/vendor/jquery.contextMenu.min.css') %]" />
    <link rel="stylesheet" type="text/css" href="[% c.url_for('/css/vendor/ReactToastify.min.css') %]" />
    <link rel="stylesheet" type="text/css" href="[% c.url_for('/css/vendor/sweetalert2.min.css') %]" />
    <link rel="stylesheet" type="text/css" href="[% c.url_for('/css/vendor/awesomplete.css') %]" />

    [% csshead %]

    <script src="[% c.url_for('/js/vendor/jquery.min.js') %]" type="text/JAVASCRIPT"></script>
    <script src="[% c.url_for('/js/vendor/jquery.ui.position.min.js') %]" type="text/JAVASCRIPT"></script>
    <script src="[% c.url_for('/js/vendor/jquery.contextMenu.min.js') %]" type="text/JAVASCRIPT"></script>
    <script src="[% c.url_for('/js/vendor/preact.umd.js') %]" type="text/JAVASCRIPT"></script>
    <script src="[% c.url_for('/js/vendor/hooks.umd.js') %]" type="text/JAVASCRIPT"></script>
    <script src="[% c.url_for('/js/vendor/compat.umd.js') %]" type="text/JAVASCRIPT"></script>
    <script>window.React = window.preactCompat; window.react = window.preactCompat;</script>
    <script src="[% c.url_for('/js/vendor/clsx.min.js') %]" type="text/JAVASCRIPT"></script>
    <script src="[% c.url_for('/js/vendor/react-toastify.umd.js') %]" type="text/JAVASCRIPT"></script>
    <script src="[% c.url_for('/js/vendor/sweetalert2.min.js') %]" type="text/JAVASCRIPT"></script>
    <script src="[% c.url_for('/js/vendor/awesomplete.min.js') %]" type="text/JAVASCRIPT"></script>
    
    <script src="[% c.url_for('/js/i18n.js?version=' _ version) %]" type="text/JAVASCRIPT"></script>
    <script src="[% c.url_for('/js/common.js?version=' _ version) %]" type="text/JAVASCRIPT"></script>
    <script src="[% c.url_for('/js/server.js?version=' _ version) %]" type="text/JAVASCRIPT"></script>
    <script src="[% c.url_for('/js/tankoubon.js?version=' _ version) %]" type="text/JAVASCRIPT"></script>

    <style>
        /* Grid View */
        .grid-view {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
            gap: 2px;
            padding: 2px;
        }

        .tankoubon-card {
            background: #363940;
            border-radius: 4px;
            display: flex;
            flex-direction: column;
            position: relative;
            cursor: pointer;
            aspect-ratio: 0.7;
            min-height: unset;
            height: 100%;
        }

        .tankoubon-card .info {
            padding: 1px;
            order: -1;  /* Move to the top */
        }

        .tankoubon-card .name {
            display: none; /* Hide the title while keeping the element in DOM */
        }

        .tankoubon-card .preview {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            height: auto;
            padding: 4px;
        }

        .tankoubon-card .preview img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            max-height: none;
        }

        .archive-count {
            position: absolute;
            top: 22px;  /* Adjusted for smaller title area */
            right: 4px;
            background: rgba(70, 130, 180, 0.9);
            color: white;
            padding: 2px 4px;
            border-radius: 8px;
            font-size: 8pt;
            font-weight: bold;
            z-index: 1;
            display: flex;
            align-items: center;
            gap: 2px;
        }

        .archive-count i {
            font-size: 8pt;
        }

        /* List View */
        .table-list {
            width: 100%;
            border-collapse: collapse;
            font-size: 8pt;
        }

        .table-list th {
            font-weight: bold;
            text-align: left;
            padding: 4px 8px;
            background: #363940;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .table-list td {
            text-align: left;
            padding: 4px 8px;
            border-right: 1px solid #40454b;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .table-list tr:nth-child(odd) {
            background: #4F535B;
        }

        .table-list tr:nth-child(even) {
            background: #363940;
        }

        .table-list tr:hover {
            background-color: #4a4e57 !important;
        }

        /* Controls */
        .table-options {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 6px;
            gap: 6px;
            flex-wrap: wrap;
            font-size: 8pt;
        }

        .table-options > div {
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .table-options .stdbtn {
            padding: 3px 6px;
            font-size: 8pt;
        }

        .table-options select {
            padding: 2px 4px;
            font-size: 8pt;
        }

        .mode-toggle {
            padding: 3px;
            opacity: 0.7;
            color: inherit;
            text-decoration: none;
        }

        .mode-toggle.active {
            opacity: 1;
            color: #4a9eff;
        }

        .sort-options {
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .sort-options select {
            padding: 2px 4px;
            font-size: 8pt;
        }

        .sort-order {
            cursor: pointer;
            opacity: 0.7;
            transition: opacity 0.2s;
            background: none;
            border: none;
            padding: 0;
            margin: 0;
            display: flex;
            align-items: center;
            color: inherit;
        }

        .sort-order:hover {
            opacity: 1;
        }

        .sort-order i {
            pointer-events: none;
        }

        .sort-order.asc .fa-sort-alpha-down {
            display: inline-block;
        }

        .sort-order.asc .fa-sort-alpha-up {
            display: none;
        }

        .sort-order.desc .fa-sort-alpha-down {
            display: none;
        }

        .sort-order.desc .fa-sort-alpha-up {
            display: inline-block;
        }

        /* Responsive adjustments */
        @media (max-width: 768px) {
            /* Make the main container more compact */
            .ido {
                padding: 6px;
                margin: 4px;
                width: auto;
                max-width: none;
            }

            /* Navigation styles */
            #nb {
                display: flex;
                flex-wrap: wrap;
                justify-content: center;
                gap: 4px;
                padding: 4px;
                font-size: 8pt;
            }

            #nb a {
                display: inline-flex;
                align-items: center;
                padding: 3px 6px;
                background: rgba(54, 57, 64, 0.6);
                border-radius: 4px;
                white-space: nowrap;
            }

            #nb span {
                display: none;
            }

            #nb i.fa-caret-right {
                display: none;
            }

            /* Adjust title spacing */
            .ih {
                margin: 4px auto;
                padding-bottom: 4px;
            }

            /* Make controls more compact */
            .table-options {
                flex-direction: column;
                gap: 8px;
                margin: 6px 0;
            }

            .table-options > div {
                width: 100%;
                display: flex;
                flex-wrap: wrap;
                gap: 4px;
                align-items: center;
            }

            /* Action buttons container */
            .table-options > div:first-child {
                display: grid;
                grid-template-columns: repeat(3, 1fr);
            }

            /* Sort options container */
            .table-options > div:nth-child(2) {
                justify-content: space-between;
            }

            /* Page options container */
            .table-options > div:last-child {
                justify-content: space-between;
            }

            /* Exactly 3 thumbnails per row with proper aspect ratio */
            .grid-view {
                grid-template-columns: repeat(3, 1fr);
                gap: 4px;
                padding: 4px;
            }

            .tankoubon-card {
                min-height: unset;
                margin: 0;
                padding: 0;
            }

            .tankoubon-card .preview {
                height: auto;
                padding: 2px;
            }

            .tankoubon-card .preview img {
                max-height: none;
            }

            .tankoubon-card .name {
                font-size: 10px;
                padding: 2px;
                line-height: 1.2;
            }

            .archive-count {
                font-size: 7pt;
                padding: 1px 3px;
                top: 8px;
            }

            /* Make buttons more compact */
            .table-options .stdbtn {
                width: 100%;
                min-width: 0;
                padding: 6px;
                height: auto;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 4px;
                font-size: 11px;
            }

            .table-options select {
                flex: 1;
                min-width: 60px;
                padding: 6px;
                height: auto;
                font-size: 11px;
            }

            .sort-options {
                width: 100%;
                justify-content: space-between;
            }

            .sort-order {
                padding: 4px;
            }

            .sort-order i {
                font-size: 1.2em;
            }

            .view-options {
                width: 100%;
                display: flex;
                justify-content: center;
                gap: 8px;
                margin-top: 4px;
            }

            .mode-toggle {
                padding: 4px;
                font-size: 1.2em;
            }

            /* List view adjustments */
            .table-list {
                font-size: 11px;
            }

            .table-list th,
            .table-list td {
                padding: 8px 6px;
            }

            .table-list td:not(:first-child) {
                display: none;
            }

            .table-list td:first-child {
                white-space: normal;
                line-height: 1.2;
            }

            /* Empty state and loading adjustments */
            #empty-state, #loading-indicator {
                padding: 16px 8px;
                font-size: 12px;
            }

            #empty-state i, #loading-indicator i {
                font-size: 2em;
                margin-bottom: 8px;
            }

            /* Improve touch targets while keeping compact */
            .stdbtn,
            select,
            .mode-toggle,
            .sort-order {
                min-height: 36px;
                min-width: 36px;
            }

            /* Add touch feedback */
            .tankoubon-card:active,
            .table-list tr:active {
                background-color: #4a4e57;
            }

            .mode-toggle:active,
            .sort-order:active {
                opacity: 0.7;
            }
        }

        /* Additional breakpoint for very small screens */
        @media (max-width: 320px) {
            .tankoubon-card {
                aspect-ratio: 0.7;
            }

            .tankoubon-card .preview {
                padding: 1px;
            }
        }
    </style>
</head>

<body>
    [% IF userlogged %]
    <p id="nb">
        <i class="fa fa-caret-right"></i>
        <a href="[% c.url_for("/upload") %]">[% c.lh("Add Archives") %]</a>
        <span style="margin-left:5px"></span>
        <i class="fa fa-caret-right"></i>
        <a href="[% c.url_for("/batch") %]">[% c.lh("Batch Operations") %]</a>
        <span style="margin-left:5px"></span>
        <i class="fa fa-caret-right"></i>
        <a href="[% c.url_for("/config") %]">[% c.lh("Settings") %]</a>
        <span style="margin-left:5px"></span>
        <i class="fa fa-caret-right"></i>
        <a href="[% c.url_for("/config/categories") %]">[% c.lh("Modify Categories") %]</a>
        <span style="margin-left:5px"></span>
        <i class="fa fa-caret-right"></i>
        <a href="[% c.url_for("/category_grid") %]">[% c.lh("Category Grid") %]</a>
        <span style="margin-left:5px"></span>
        <i class="fa fa-caret-right"></i>
        <a href="[% c.url_for("/tankoubons") %]">[% c.lh("Tankoubon") %]</a>
        <span style="margin-left:5px"></span>
        <i class="fa fa-caret-right"></i>
        <a href="[% c.url_for("/stats") %]">[% c.lh("Statistics") %]</a>
        <i class="fa fa-caret-right"></i>
        <a href="[% c.url_for("/logs") %]">[% c.lh("Logs") %]</a>
    </p>
    [% ELSE %]
    <p id="nb">
        <i class="fa fa-caret-right"></i>
        <a href="[% c.url_for("/login") %]">[% c.lh("Admin Login") %]</a>
        <span style="margin-left:5px"></span>
        <i class="fa fa-caret-right"></i>
        <a href="[% c.url_for("/stats") %]">[% c.lh("Statistics") %]</a>
    </p>
    [% END %]

    <div class="ido">
        <h1 class="ih">[% c.lh("Tankoubon Management") %]</h1>

        <div class="table-options">
            <div>
                <button id="new-tankoubon" class="stdbtn">
                    <i class="fas fa-plus"></i> [% c.lh("New Tankoubon") %]
                </button>
                <button id="refresh" class="stdbtn">
                    <i class="fas fa-sync"></i> [% c.lh("Refresh") %]
                </button>
                <button id="return" class="stdbtn">
                    <i class="fas fa-arrow-left"></i> [% c.lh("Return") %]
                </button>
            </div>

            <div class="sort-options">
                [% c.lh("Sort by:") %]
                <select id="sort-by" class="favtag-btn">
                    <option value="name">[% c.lh("Name") %]</option>
                    <option value="date_added">[% c.lh("Date Added") %]</option>
                    <option value="last_updated">[% c.lh("Last Updated") %]</option>
                    <option value="archive_count">[% c.lh("Archive Count") %]</option>
                </select>
                <button class="sort-order" title="[% c.lh('Sort Order') %]">
                    <i class="fa fa-sort-alpha-down fa-2x"></i>
                    <i class="fa fa-sort-alpha-up fa-2x"></i>
                </button>
            </div>

            <div>
                [% c.lh("Items per page:") %]
                <select class="favtag-btn" id="page-size">
                    <option value="25">25</option>
                    <option value="50">50</option>
                    <option value="100" selected>100</option>
                    <option value="200">200</option>
                </select>

                [% c.lh("Page:") %]
                <select class="favtag-btn" id="page-select"></select>

                <div class="view-options">
                    <a class="mode-toggle fa fa-th fa-2x grid-toggle active" href="#" title="[% c.lh('Grid View') %]"></a>
                    <a class="mode-toggle fa fa-list fa-2x list-toggle" href="#" title="[% c.lh('List View') %]"></a>
                </div>
            </div>
        </div>

        <div id="tankoubon-list"></div>

        <div id="loading-indicator" style="display: none;">
            <i class="fa fa-4x fa-spinner fa-spin"></i>
        </div>

        <div id="empty-state" style="display: none;">
            <i class="fa fa-4x fa-book-open"></i>
            <span>[% c.lh("No tankoubons found.") %]</span>
        </div>
    </div>

    [% INCLUDE footer %]

    <script>
        jQuery(() => {
            Tankoubon.initializeAll();
        });
    </script>
</body>

</html> 