<!DOCTYPE html>

<head>
    <title>[% title %] - [% tank.name %]</title>

    <meta name="viewport" content="width=device-width" />
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />

    <link type="image/png" rel="icon" href="[% c.url_for('/favicon.ico') %]" />
    <link rel="stylesheet" type="text/css" href="[% c.url_for('/css/lrr.css?version=' _ version) %]" />
    <link rel="stylesheet" type="text/css" href="[% c.url_for('/css/vendor/fontawesome-all.min.css') %]" />
    <link rel="stylesheet" type="text/css" href="[% c.url_for('/css/vendor/ReactToastify.min.css') %]" />
    <link rel="stylesheet" type="text/css" href="[% c.url_for('/css/vendor/sweetalert2.min.css') %]" />

    <style>
        .tankoubon-header {
            display: flex;
            gap: 16px;
            margin-bottom: 8px;
            padding: 8px;
        }

        .tankoubon-cover {
            width: 200px;
            height: 280px;
            overflow: hidden;
            border-radius: 9px;
            background: #2a2a2a;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .tankoubon-cover img {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
        }

        .tankoubon-info {
            flex: 1;
            min-width: 0;
        }

        .tankoubon-title {
            font-size: 20px;
            margin-bottom: 10px;
        }

        .tankoubon-stats {
            color: #999;
            margin-bottom: 15px;
            font-size: 0.9em;
        }

        .tag-list {
            line-height: 1.4;
            color: #ccc;
            word-wrap: break-word;
            font-size: 0.9em;
        }

        .episode-nav {
            display: flex;
            flex-wrap: wrap;
            gap: 4px;
            margin: 15px 0;
            padding: 10px;
            background: #2a2a2a;
            border-radius: 4px;
            justify-content: center;
            max-width: 800px;
            margin-left: auto;
            margin-right: auto;
        }

        .episode-nav-container {
            display: flex;
            flex-wrap: wrap;
            gap: 4px;
            justify-content: center;
            width: 100%;
        }

        .episode-nav-item {
            position: relative;
            width: 28px;
            height: 28px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #363940;
            border-radius: 3px;
            color: #fff;
            font-size: 12px;
            cursor: pointer;
            transition: all 0.2s ease;
            border: 1px solid #4f535b;
        }

        .episode-nav-item:hover {
            background: #4f535b;
            transform: translateY(-1px);
        }

        .episode-nav-item.current {
            background: #4a9eff;
            border-color: #4a9eff;
        }

        .episode-nav-item.read {
            background: #28a745;
            border-color: #28a745;
        }

        .episode-nav-item.reading {
            background: #ffc107;
            border-color: #ffc107;
            color: #000;
        }

        .episode-nav-tooltip {
            position: absolute;
            bottom: 100%;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(0, 0, 0, 0.8);
            color: #fff;
            padding: 4px 8px;
            border-radius: 4px;
            font-size: 12px;
            white-space: nowrap;
            pointer-events: none;
            opacity: 0;
            transition: opacity 0.2s;
            margin-bottom: 8px;
            z-index: 100;
            max-width: 200px;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .episode-nav-item:hover .episode-nav-tooltip {
            opacity: 1;
        }

        .episode-nav-tooltip::after {
            content: '';
            position: absolute;
            top: 100%;
            left: 50%;
            transform: translateX(-50%);
            border-width: 4px;
            border-style: solid;
            border-color: rgba(0, 0, 0, 0.8) transparent transparent transparent;
        }

        .episode-nav-ellipsis {
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 14px;
            padding: 0 8px;
        }

        .episode-nav-expand {
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 8px;
            margin-top: 8px;
            background: #363940;
            border-radius: 3px;
            color: #fff;
            font-size: 13px;
            cursor: pointer;
            transition: all 0.2s ease;
            border: 1px solid #4f535b;
        }

        .episode-nav-expand:hover {
            background: #4f535b;
        }

        .episode-nav-expand i {
            font-size: 12px;
            transition: transform 0.2s ease;
        }

        .episode-nav-expand:hover i {
            transform: translateY(2px);
        }

        .tankoubon-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-bottom: 8px;
            justify-content: center;
        }

        .tankoubon-actions .stdbtn {
            padding: 8px 12px;
            font-size: 13px;
            display: flex;
            align-items: center;
            gap: 6px;
            min-width: 120px;
            justify-content: center;
        }

        .tankoubon-actions .stdbtn i {
            width: 14px;
            text-align: center;
        }

        .tankoubon-actions .delete-btn {
            margin-top: 0;
            background-color: #dc3545;
            color: white;
        }

        .tankoubon-actions .delete-btn:hover {
            background-color: #c82333;
        }

        .episode-nav-container {
            background: rgba(54, 57, 64, 0.6);
            padding: 8px;
            border-radius: 4px;
            max-width: 600px;
            margin: 0 auto 8px;
        }

        .archive-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
            gap: 8px;
            padding: 8px;
        }

        .archive-card {
            background: none repeat scroll 0 0 #43464E;
            border: 1px none;
            border-radius: 4px;
            display: inline-block;
            margin: 1px;
            padding: 1px;
            vertical-align: top;
            min-height: 265px;
            cursor: pointer;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
            position: relative;
            display: flex;
            flex-direction: column;
        }

        .archive-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 3px 6px rgba(0,0,0,0.1);
        }

        .archive-card .title {
            font-family: "Geist", arial, sans-serif;
            font-weight: bold;
            margin: 4px auto;
            text-align: center;
            width: 98%;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            font-size: 8pt;
            padding: 1px 0;
            min-height: 16px;
            order: -1;  /* Move to the top */
            flex: 0 0 auto;
        }

        .archive-card img {
            max-width: 99%;
            max-height: 242px;
            object-fit: contain;
            border-radius: 3px;
            vertical-align: middle;
            margin: auto;
        }

        .archive-card .thumbnail-container {
            height: 245px;
            margin: 0 auto;
            overflow: hidden;
            position: relative;
            text-align: center;
            flex: 1 0 245px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .archive-list {
            padding: 10px;
        }

        .archive-list-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 8px;
            background: #363940;
            border-radius: 4px;
            margin-bottom: 8px;
            cursor: pointer;
        }

        .archive-list-item:hover {
            transform: translateY(-1px);
            transition: transform 0.2s ease;
        }

        .archive-list-item img {
            width: 40px;
            height: 56px;
            object-fit: cover;
            border-radius: 3px;
        }

        .archive-list-item .info {
            flex: 1;
        }

        .archive-list-item .title {
            font-size: 14px;
            margin-bottom: 4px;
        }

        .archive-list-item .stats {
            font-size: 11px;
            color: #999;
        }

        .continuous-view {
            padding: 10px;
        }

        .continuous-view img {
            max-width: 100%;
            height: auto;
            margin-bottom: 15px;
            border-radius: 4px;
        }

        .progress-indicator {
            display: inline-block;
            padding: 1px 4px;
            border-radius: 2px;
            font-size: 10px;
            margin-left: 4px;
        }

        .progress-new {
            background: #28a745;
            color: white;
        }

        .progress-reading {
            background: #ffc107;
            color: black;
        }

        .progress-completed {
            background: #6c757d;
            color: white;
        }

        .quick-episode-menu {
            margin-bottom: 12px;
        }

        .episode-select {
            width: 100%;
            max-width: 250px;
            padding: 6px 10px;
            border: 1px solid #4f535b;
            border-radius: 4px;
            background: #2a2a2a;
            color: #fff;
            font-size: 13px;
            cursor: pointer;
        }

        .episode-select:focus {
            outline: none;
            border-color: #6c757d;
        }

        .episode-select option {
            background: #2a2a2a;
            color: #fff;
            padding: 6px;
        }

        @media (max-width: 768px) {
            .tankoubon-header {
                flex-direction: column;
                gap: 10px;
            }

            .tankoubon-cover {
                width: 160px;
                height: 224px;
                margin: 0 auto;
            }

            .tankoubon-actions {
                justify-content: center;
            }

            .archive-grid {
                grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
            }

            .episode-nav {
                justify-content: center;
                padding: 8px;
            }

            .episode-nav-item {
                width: 24px;
                height: 24px;
                font-size: 11px;
            }

            .archive-card {
                min-height: 240px;
            }

            .archive-card .thumbnail-container {
                height: 190px;
            }

            .archive-card img {
                max-height: 185px;
            }
        }

        @font-face {
            font-family: "Geist";
            font-style: normal;
            font-weight: bold;
            src: url(../css/webfonts/Geist-Regular.woff2) format("woff2");
        }

        @font-face {
            font-family: "Geist";
            font-style: normal;
            font-weight: bold;
            src: url(../css/webfonts/Geist-SemiBold.woff2) format("woff2");
        }

        .pagination-controls {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            margin: 10px;
            padding: 10px;
            background: #2a2a2a;
            border-radius: 4px;
        }

        .pagination-controls .page-nav {
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .pagination-controls .page-nav button {
            padding: 4px 8px;
            border-radius: 4px;
            background: #363940;
            color: #fff;
            border: 1px solid #4f535b;
            cursor: pointer;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            gap: 4px;
            min-width: 32px;
            justify-content: center;
        }

        .pagination-controls .page-nav button:hover:not(:disabled) {
            background: #4f535b;
        }

        .pagination-controls .page-nav button:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        .pagination-controls select {
            padding: 4px 8px;
            border-radius: 4px;
            background: #363940;
            color: #fff;
            border: 1px solid #4f535b;
            min-width: 70px;
        }

        .pagination-controls label {
            color: #999;
            font-size: 0.9em;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .pagination-info {
            color: #999;
            font-size: 0.9em;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .empty-message, .error-message, .loading-indicator {
            text-align: center;
            padding: 40px;
            color: #999;
            background: #2a2a2a;
            border-radius: 4px;
            margin: 10px;
        }

        .error-message {
            color: #dc3545;
        }

        .empty-message i, .error-message i, .loading-indicator i {
            margin-bottom: 15px;
            color: inherit;
        }
    </style>

    [% csshead %]

    <script src="[% c.url_for('/js/vendor/jquery.min.js') %]" type="text/JAVASCRIPT"></script>
    <script src="[% c.url_for('/js/vendor/preact.umd.js') %]" type="text/JAVASCRIPT"></script>
    <script src="[% c.url_for('/js/vendor/hooks.umd.js') %]" type="text/JAVASCRIPT"></script>
    <script src="[% c.url_for('/js/vendor/compat.umd.js') %]" type="text/JAVASCRIPT"></script>
    <script>window.React = window.preactCompat; window.react = window.preactCompat;</script>
    <script src="[% c.url_for('/js/vendor/clsx.min.js') %]" type="text/JAVASCRIPT"></script>
    <script src="[% c.url_for('/js/vendor/react-toastify.umd.js') %]" type="text/JAVASCRIPT"></script>
    <script src="[% c.url_for('/js/vendor/sweetalert2.min.js') %]" type="text/JAVASCRIPT"></script>
    
    <script src="[% c.url_for('/js/i18n.js?version=' _ version) %]" type="text/JAVASCRIPT"></script>
    <script src="[% c.url_for('/js/common.js?version=' _ version) %]" type="text/JAVASCRIPT"></script>
    <script src="[% c.url_for('/js/server.js?version=' _ version) %]" type="text/JAVASCRIPT"></script>
    <script src="[% c.url_for('/js/tankoubon_view.js?version=' _ version) %]" type="text/JAVASCRIPT"></script>
</head>

<body>

    [% IF userlogged %]
    <p id="nb">
        <i class="fa fa-caret-right"></i>
        <a href="[% c.url_for('/upload') %]">[% c.lh("Add Archives") %]</a>
        <span style="margin-left:5px"></span>
        <i class="fa fa-caret-right"></i>
        <a href="[% c.url_for('/batch') %]">[% c.lh("Batch Operations") %]</a>
        <span style="margin-left:5px"></span>
        <i class="fa fa-caret-right"></i>
        <a href="[% c.url_for('/config') %]">[% c.lh("Settings") %]</a>
        <span style="margin-left:5px"></span>
        <i class="fa fa-caret-right"></i>
        <a href="[% c.url_for('/config/categories') %]">[% c.lh("Modify Categories") %]</a>
        <span style="margin-left:5px"></span>
        <i class="fa fa-caret-right"></i>
        <a href="[% c.url_for('/category_grid') %]">[% c.lh("Category Grid") %]</a>
        <span style="margin-left:5px"></span>
        <i class="fa fa-caret-right"></i>
        <a href="[% c.url_for('/tankoubons') %]">[% c.lh("Tankoubon") %]</a>
        <span style="margin-left:5px"></span>
        <i class="fa fa-caret-right"></i>
        <a href="[% c.url_for('/stats') %]">[% c.lh("Statistics") %]</a>
        <i class="fa fa-caret-right"></i>
        <a href="[% c.url_for('/logs') %]">[% c.lh("Logs") %]</a>
    </p>
    [% ELSE %]
    <p id="nb">
        <i class="fa fa-caret-right"></i>
        <a href="[% c.url_for('/login') %]">[% c.lh("Admin Login") %]</a>
        <span style="margin-left:5px"></span>
        <i class="fa fa-caret-right"></i>
        <a href="[% c.url_for('/stats') %]">[% c.lh("Statistics") %]</a>
    </p>
    [% END %]

    <div class='ido'>
        <div class='tankoubon-header'>
            <div class='tankoubon-cover'>
                [% IF tank.cover_archive %]
                <img src="[% c.url_for('/api/archives/' _ tank.cover_archive _ '/thumbnail') %]" alt="Cover" />
                [% ELSE %]
                <i class="fas fa-book fa-4x" style="color: #666;"></i>
                [% END %]
            </div>
            <div class='tankoubon-info'>
                <h2 class='tankoubon-title'>[% tank.name %]</h2>
                <div class='tankoubon-stats'>
                    <div>[% tank.archives.size %] Archives</div>
                    [% IF tank.last_updated %]
                    <div style="margin-top: 10px;">
                        <span style="color: #999;">Last Updated:</span>
                        <span>[% USE date %][% date.format(tank.last_updated, '%Y-%m-%d %H:%M:%S') %]</span>
                    </div>
                    [% END %]
                    [% IF tank.tags %]
                    <div style="margin-top: 10px;">
                        <span style="color: #999;">Tags:</span>
                        <div class="tag-list" style="margin-top: 5px;">[% tank.tags %]</div>
                    </div>
                    [% END %]
                    [% IF tank.summary %]
                    <div style="margin-top: 10px;">[% tank.summary %]</div>
                    [% END %]
                </div>
                <div class='tankoubon-actions'>
                    <button class='stdbtn edit-btn' onclick='TankoubonView.editTankoubon()'>
                        <i class='fas fa-edit'></i> [% c.lh("Edit") %]
                    </button>
                    <button class='stdbtn' onclick='TankoubonView.manageArchives()'>
                        <i class='fas fa-list'></i> [% c.lh("Manage Archives") %]
                    </button>
                    <button class='stdbtn delete-btn' onclick='TankoubonView.deleteTankoubon()'>
                        <i class='fas fa-trash'></i> [% c.lh("Delete") %]
                    </button>
                    <button class='stdbtn delete-btn' onclick='TankoubonView.deleteTankoubon(true)' style="background-color: #b71c1c;">
                        <i class='fas fa-trash-alt'></i> [% c.lh("Delete (All)") %]
                    </button>
                </div>
                <div class='episode-nav' id='episode-nav'>
                    <!-- Episodes will be loaded here by JavaScript -->
                </div>
            </div>
        </div>

        <div class="pagination-controls">
            <div class="pagination-info">
                [% c.lh("Showing") %] <span id="showing-count">0</span> [% c.lh("of") %] <span id="total-count">0</span> [% c.lh("archives") %]
            </div>
            <div class="page-nav">
                <button id="first-page" class="favtag-btn" title="[% c.lh('First Page') %]">1</button>
                <button id="prev-page" class="favtag-btn" title="[% c.lh('Previous Page') %]">
                    <i class="fas fa-angle-left"></i>
                </button>
                <select id="page-select" class="favtag-btn"></select>
                <button id="next-page" class="favtag-btn" title="[% c.lh('Next Page') %]">
                    <i class="fas fa-angle-right"></i>
                </button>
                <button id="last-page" class="favtag-btn" title="[% c.lh('Last Page') %]">
                    <span id="last-page-number">1</span>
                </button>
            </div>
            <div class="page-size">
                <label>
                    [% c.lh("Items per page:") %]
                    <select id="items-per-page" class="favtag-btn">
                        <option value="25">25</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                        <option value="200">200</option>
                    </select>
                </label>
            </div>
        </div>

        <div id="archives-container"></div>

        <div class="pagination-controls">
            <div class="pagination-info">
                [% c.lh("Showing") %] <span id="showing-count-bottom">0</span> [% c.lh("of") %] <span id="total-count-bottom">0</span> [% c.lh("archives") %]
            </div>
            <div class="page-nav">
                <button id="first-page-bottom" class="favtag-btn" title="[% c.lh('First Page') %]">1</button>
                <button id="prev-page-bottom" class="favtag-btn" title="[% c.lh('Previous Page') %]">
                    <i class="fas fa-angle-left"></i>
                </button>
                <select id="page-select-bottom" class="favtag-btn"></select>
                <button id="next-page-bottom" class="favtag-btn" title="[% c.lh('Next Page') %]">
                    <i class="fas fa-angle-right"></i>
                </button>
                <button id="last-page-bottom" class="favtag-btn" title="[% c.lh('Last Page') %]">
                    <span id="last-page-number-bottom">1</span>
                </button>
            </div>
            <div class="page-size">
                <label>
                    [% c.lh("Items per page:") %]
                    <select id="items-per-page-bottom" class="favtag-btn">
                        <option value="25">25</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                        <option value="200">200</option>
                    </select>
                </label>
            </div>
        </div>

        <div id="loading-indicator" style="display: none;">
            <i class="fa fa-4x fa-spinner fa-spin"></i>
        </div>

        <br><br>
        <input id='return' class='stdbtn' type='button' value='[% c.lh("Return to Tankoubons") %]' onclick='window.location.href="[% c.url_for("/tankoubons") %]"' />
    </div>

    [% INCLUDE footer %]
</body>

</html> 